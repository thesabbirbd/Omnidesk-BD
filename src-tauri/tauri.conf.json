{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Omnidesk BD",
  "version": "1.3.27",
  "identifier": "com.omnidesk.bd",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/thesabbirbd/Omnidesk-BD/releases/latest/download/latest.json"
      ],
      "pubkey": "%TAURI_UPDATER_PUBLIC_KEY%"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Omnidesk BD",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["bin/backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
