# ==============================================================================
# StudyOS v1.2.4 — Environment Configuration Template
# Copy this file to `backend/.env` for local backend development
# ==============================================================================

# Application Metadata
PROJECT_NAME="Omnidesk BD API"
VERSION="1.2.4"
API_V1_STR="/api"

# Database Configuration (PostgreSQL default, with SQLite fallback support)
# PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://admin:secret123@localhost:5432/studyos_db"
# Fallback SQLite for offline testing: sqlite:///./studyos.db

# JWT Authentication & Security Settings
# Generate a secure key in terminal: openssl rand -hex 32
SECRET_KEY="09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7"
REFRESH_SECRET_KEY="e4d6a1b2c3f890123456789abcdef0123456789abcdef0123456789abcdef012"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # 24 Hours
REFRESH_TOKEN_EXPIRE_DAYS=30          # 30 Days

# Cross-Origin Resource Sharing (CORS)
# Add your client frontend URLs (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# File Storage & Uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=50

# Optional Redis / Background Workers (Disabled by default for local-first zero-cost operation)
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379/0"

# Optional AI Providers (NO PAID API REQUIRED - Gemini Free Tier / Local Ollama)
AI_PROVIDER="none"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
