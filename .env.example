# ==========================================
# OMNIDESK BD - ENVIRONMENT SECRETS BASELINE
# ==========================================
# WARNING: NEVER COMMIT ACTUAL SECRETS (.env) TO VERSION CONTROL.
# Copy this file to .env and populate with your own credentials.

# -----------------
# SECURITY & AUTH
# -----------------
JWT_SECRET_KEY="replace_with_a_super_strong_random_secret_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 Days

# -----------------
# AI PROVIDERS
# -----------------
GEMINI_API_KEY="your_google_gemini_api_key_here"
# OLLAMA_HOST="http://localhost:11434" # Optional: If running Ollama remotely

# -----------------
# EXTERNAL APIS
# -----------------
# YOUTUBE_API_KEY="your_youtube_data_api_key_here" # For fetching video metadata

# -----------------
# TAURI & MOBILE SIGNING (Do not put in this file, use GH Secrets or local env)
# -----------------
# TAURI_PRIVATE_KEY=""
# TAURI_KEY_PASSWORD=""
